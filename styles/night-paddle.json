{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Night Paddle",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "base", "color": "#14261B", "name": "Sandbar" },
				{ "slug": "contrast", "color": "#F4EFE3", "name": "Deep Forest" },
				{ "slug": "accent-1", "color": "#3E7B4E", "name": "River Green" },
				{ "slug": "accent-2", "color": "#D4A373", "name": "Driftwood" },
				{ "slug": "river-mist", "color": "#22412E", "name": "River Mist" },
				{ "slug": "whitecap", "color": "#FFFFFF", "name": "Whitecap" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"elements": {
			"link": {
				"color": { "text": "var:preset|color|contrast" },
				":hover": {
					"color": { "text": "var:preset|color|accent-2" }
				}
			}
		},
		"blocks": {
			"core/site-logo": {
				"css": "& img { background-color: var(--wp--preset--color--contrast); border-radius: 8px; padding: 4px 10px; }"
			}
		}
	}
}
